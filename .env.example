ENVIRONMENT=development
CONFIG_DIR="configs"
LOG_DIR="logs"
VDB_DIR="vectorstore"
IMAGE_DIR="images"

BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"
GOOGLE_CLIENT_ID=

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/study_companion
RESET_DB=False

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# --- SMTP (for email verification / password reset emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- AI ---
OPENAI_API_KEY=
HF_TOKEN=

# Stop checking new versions of the models at startup
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# AI Model Device Configuration ('cpu' prevents CUDA kernel mismatch crashes)
EMBEDDING_DEVICE=cpu

# Automatic update times for models
MODEL_UPDATE_DAY=sun
MODEL_UPDATE_HOUR=3
